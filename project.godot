config_version=5

[application]

config/name="Bibliothek entstauben"
config/description="Prototyp: eine riesige Bibliothek Stück für Stück entstauben."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

