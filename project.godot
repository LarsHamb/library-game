config_version=5

[application]

config/name="Strandgut"
config/description="Einen Strand voller Müll Stück für Stück aufräumen – erst per Hand, dann mit Maschinen."
run/main_scene="res://scenes/beach.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
